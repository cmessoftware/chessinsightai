# Datasets y backups
*.zip filter=lfs diff=lfs merge=lfs -text
# Partidas grandes bajo data/ (los *.pgn trackeados en docs/tests van en Git normal)
data/**/*.pgn filter=lfs diff=lfs merge=lfs -text
src/processed_games/**/*.pgn filter=lfs diff=lfs merge=lfs -text
# Notebooks pesados (opcional, evaluá si los outputs inflan mucho)
*.ipynb filter=lfs diff=lfs merge=lfs -text
# Documentación y fixtures CI: fuera de LFS (evita timeout batch LFS en Render)
docs/**/*.pgn -filter -diff -merge
tests/**/*.pgn -filter -diff -merge
test_data/**/*.pgn -filter -diff -merge
