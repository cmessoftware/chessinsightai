# Configuración del entorno de desarrollo
JWT_SECRET_KEY=chess-trainer-secret-key-2024-development
DATABASE_URL=postgresql://chess_user:chess_password@localhost:5432/chess_trainer
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Configuración de Stockfish (opcional)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Maia-3 sparring (SPAR-01) — ver docs/ai_chess_coach/devops/spar-01-openspec-maia3.md
# MAIA_PROVIDER=maia3
# MAIA3_CMD=maia3-5m
# MAIA3_DEFAULT_ELO=1500
# MAIA3_DEVICE=cpu
# MAIA3_USE_UCI_HISTORY=1
# MAIA3_EXTRA_ARGS=--no-use-amp
# MAIA_MOVE_TIMEOUT_SEC=60
# MAIA3_PYTHON=
# MAIA3_MODULE=maia3.uci
# MAIA3_MODEL=5m
# Fallback Lc0+Maia-2:
# MAIA_PROVIDER=lc0_maia2
# MAIA_ENGINE_PATH=C:\chessengines\lc0\lc0.exe
# MAIA_WEIGHTS_DIR=C:\chessengines\maia
