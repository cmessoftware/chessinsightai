# Configuración del entorno de desarrollo
JWT_SECRET_KEY=chess-trainer-secret-key-2024-development
DATABASE_URL=postgresql://chess_user:chess_password@localhost:5432/chess_trainer
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Configuración de Stockfish (opcional)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Comentarios → GitHub (LOG-FEAT-10 / FEAT-120–122)
# GITHUB_FEEDBACK_TOKEN=ghp_...   # Issues + Contents: Read and write (embeber imágenes en el issue)
# GITHUB_FEEDBACK_REPO=cmessoftware/chessinsightai
# GITHUB_FEEDBACK_ATTACHMENTS_BRANCH=feedback-attachments  # rama sin regla «solo PR» (main suele estar bloqueada)
# FEEDBACK_ATTACHMENT_PUBLIC_BASE_URL=https://tu-api-publica.example  # fallback en prod si falla Contents API
# FEEDBACK_ATTACHMENTS_DIR=data/feedback_attachments

# PGM · import PGN Mentor (src/scripts/import_pgm_mentor_curated.py)
# PGM_MENTOR_DATA_DIR=data/games/fide_processed
# PGM_LIBRARY_OWNER_USER_ID=1
# PGM_MENTOR_CORPUS_TYPE=elite